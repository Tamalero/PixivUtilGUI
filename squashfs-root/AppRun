#!/bin/bash
# AppImage entry point.
#
# POSIX/bash on purpose: this runs on whatever machine the AppImage lands on,
# which is not guaranteed to have fish. The build script beside it is fish,
# because that one only ever runs on the author's box.
set -e
HERE="$(dirname "$(readlink -f "${0}")")"

# PyInstaller >= 6 puts the bundle under _internal/; older layouts do not.
# Pointing QT_PLUGIN_PATH at a directory that does not exist is worse than
# leaving it unset: Qt then finds no platform theme and falls back to its own
# plain file dialogs instead of the desktop's native ones.
QT_ROOT="${HERE}/usr/bin/_internal/PyQt6/Qt6"
[ -d "${QT_ROOT}" ] || QT_ROOT="${HERE}/usr/bin/PyQt6/Qt6"

if [ -d "${QT_ROOT}/plugins" ]; then
    export QT_PLUGIN_PATH="${QT_ROOT}/plugins"
fi
if [ -d "${QT_ROOT}/qml" ]; then
    export QML2_IMPORT_PATH="${QT_ROOT}/qml"
fi

# $OWD is where the user ran the AppImage from. gui.py uses it (and $APPIMAGE)
# to look for a PixivUtil2 checkout in sibling directories, since HERE is a
# throwaway mount point.
export OWD="${OWD:-$PWD}"

exec "${HERE}/usr/bin/pixivutilgui" "$@"
